# Port backend Node.js
BACKEND_PORT=4000

# Base URL backend yang dipakai frontend saat mengambil data kompetisi
BACKEND_BASE_URL=http://localhost:4000

# URL project Supabase Cloud (contoh: https://xxxx.supabase.co)
SUPABASE_URL=

# Service role key Supabase Cloud (hanya untuk server/backend)
SUPABASE_SERVICE_ROLE_KEY=

# Nama tabel kompetisi di Supabase (opsional)
SUPABASE_COMPETITIONS_TABLE=competitions

# Nama tabel pengajuan kompetisi di Supabase (opsional)
SUPABASE_SUBMISSIONS_TABLE=competition_submissions

# Path file data lokal saat SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY tidak diisi
LOCAL_COMPETITIONS_FILE_PATH=backend/.local/competitions.json

# Path file data pengajuan lokal saat fallback file aktif
LOCAL_SUBMISSIONS_FILE_PATH=backend/.local/submissions.json

# Token opsional untuk proteksi endpoint write backend (POST/PUT/DELETE)
BACKEND_ADMIN_TOKEN=

# Aktifkan hanya jika backend berada di balik reverse proxy tepercaya (Nginx/Cloudflare).
# Jika true, backend membaca IP dari header x-forwarded-for untuk rate limiting.
BACKEND_TRUST_PROXY=false

# Port frontend untuk next start di server production
PORT=3000

# Mode runtime production
NODE_ENV=production

# Kredensial dasar untuk akses panel admin
ADMIN_EMAIL=admin@compbase.id

# Hash password admin menggunakan scrypt (WAJIB diisi).
# Generate hash dengan script: pnpm admin:hash-password "password-admin-anda"
# Format: scrypt$<salt>$<hash>
ADMIN_PASSWORD_HASH=

# Secret untuk signing session admin (HMAC SHA-256).
# Di production WAJIB diisi random string panjang (minimal 32 karakter).
# Jika kosong, sistem akan mencoba derivasi dari ADMIN_PASSWORD_HASH (kurang aman).
ADMIN_SESSION_SECRET=
