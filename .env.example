# Port backend Node.js
BACKEND_PORT=4000

# Base URL backend yang dipakai frontend saat mengambil data kompetisi
BACKEND_BASE_URL=http://localhost:4000

# Token opsional untuk proteksi endpoint write backend (POST/PUT/DELETE)
BACKEND_ADMIN_TOKEN=

# Port frontend untuk next start di server production
PORT=3000

# Mode runtime production
NODE_ENV=production

# Kredensial dasar untuk akses panel admin
ADMIN_EMAIL=admin@compbase.id
ADMIN_PASSWORD=compbase-admin
