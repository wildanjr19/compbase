# Port backend Node.js
BACKEND_PORT=4000

# Base URL backend yang dipakai frontend saat mengambil data kompetisi
BACKEND_BASE_URL=http://localhost:4000

# URL project Supabase Cloud (contoh: https://xxxx.supabase.co)
SUPABASE_URL=

# Service role key Supabase Cloud (hanya untuk server/backend)
SUPABASE_SERVICE_ROLE_KEY=

# Nama tabel kompetisi di Supabase (opsional)
SUPABASE_COMPETITIONS_TABLE=competitions

# Path file data lokal saat SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY tidak diisi
LOCAL_COMPETITIONS_FILE_PATH=backend/.local/competitions.json

# Token opsional untuk proteksi endpoint write backend (POST/PUT/DELETE)
BACKEND_ADMIN_TOKEN=

# Port frontend untuk next start di server production
PORT=3000

# Mode runtime production
NODE_ENV=production

# Kredensial dasar untuk akses panel admin
ADMIN_EMAIL=admin@compbase.id
ADMIN_PASSWORD=compbase-admin
